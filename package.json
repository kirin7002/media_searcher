{
  "name": "media-searcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "多来源网盘资源搜索器，包含 Web 前端与 Node.js API 后端",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --watch --env-file-if-exists=.env backend/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  }
}

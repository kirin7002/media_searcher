# 本地运行默认只监听本机；Docker 会覆盖 HOST 为 0.0.0.0。
HOST=127.0.0.1
PORT=3210
SOURCE_TIMEOUT_MS=12000
CACHE_TTL_SECONDS=120
RATE_LIMIT_PER_MINUTE=60
# 仅在服务器完全位于可信反向代理之后、代理覆盖 X-Forwarded-For 时开启。
TRUST_PROXY=false

PANSOUSUO_BASE_URL=https://www.pansousuo.com
PANSEARCH_BASE_URL=https://www.pansearch.me
SOSOPX_BASE_URL=https://sosopx.com
SOSOPX_TIMEOUT_MS=25000
XIAOJIWO_BASE_URL=https://xiaojiwo.sylu.net
XIAOJIWO_TIMEOUT_MS=30000
RRDYNB_BASE_URL=https://www.rrdynb.com
# 公开频道只匹配最近公开帖子；设为空可关闭频道来源，最多 5 个。
TELEGRAM_CHANNELS=Aliyun_4K_Movies,Quark_Movies,shareAliyun
# 逗号分隔来源 ID，可停用某来源；例如 pansearch,tg_quark_movies。
DISABLED_SOURCES=
# 可选：自部署 PanSou。地址是服务的根地址，不包含 /api/search。
PANSOU_BASE_URL=
PANSOU_TOKEN=
# 可选：海搜开放接口的 API key，始终只保存在后端。
HAISOU_API_KEY=
HAISOU_TIMEOUT_MS=65000
# 可选：起零数据，使用 Authorization: Bearer，只在后端保存。
QILING_API_TOKEN=
QILING_TIMEOUT_MS=20000

# 新片发现：两种 TMDb 凭据任选一种，优先使用 Read Access Token。
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
DISCOVER_TIMEZONE=Asia/Shanghai

# Docker Compose 的宿主机绑定地址和端口，默认供本机 Nginx 反代。
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3210

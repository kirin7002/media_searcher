# 本地运行默认只监听本机；Docker 会覆盖 HOST 为 0.0.0.0。
HOST=127.0.0.1
PORT=3210
SOURCE_TIMEOUT_MS=12000
CACHE_TTL_SECONDS=120
RATE_LIMIT_PER_MINUTE=60
# 仅在服务器完全位于可信反向代理之后、代理覆盖 X-Forwarded-For 时开启。
TRUST_PROXY=false

PANSOUSUO_BASE_URL=https://www.pansousuo.com
# 可选：自部署 PanSou。地址是服务的根地址，不包含 /api/search。
PANSOU_BASE_URL=
PANSOU_TOKEN=
# 可选：海搜开放接口的 API key，始终只保存在后端。
HAISOU_API_KEY=
HAISOU_TIMEOUT_MS=65000

# Docker Compose 的宿主机绑定地址和端口，默认供本机 Nginx 反代。
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3210
